    "ora": "^9.3.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
